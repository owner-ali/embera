{
  "name": "embera",
  "version": "0.1.0",
  "private": true,
  "description": "EMBERA — Crafted for the Extraordinary. A premium restaurant platform by CodedByAli.",
  "scripts": {
    "dev": "set NODE_OPTIONS=--dns-result-order=ipv4first && next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "postinstall": "prisma generate",
    "db:migrate": "prisma migrate dev",
